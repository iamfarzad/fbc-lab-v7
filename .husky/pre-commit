#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running type checks..."
pnpm type-check || {
  echo "❌ Type check failed. Fix types before committing."
  echo "   Run 'pnpm type-check' to see errors"
  exit 1
}

echo "🔍 Running linter..."
pnpm lint || {
  echo "❌ Lint failed. Fix issues before committing."
  echo "   Run 'pnpm lint:fix' to auto-fix some issues"
  exit 1
}

echo "🔍 Checking for API key leaks..."
if git diff --cached | grep -E "AIza[0-9A-Za-z_-]{35}|sk-[a-zA-Z0-9]{48}"; then
  echo "❌ Found potential API keys in staged changes!"
  echo "   Use environment variables instead of hardcoding keys"
  exit 1
fi

echo "✅ All pre-commit checks passed"
