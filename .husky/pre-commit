# pnpm lint --fix

# Run type checking
echo "🔍 Running type check..."
pnpm tsc --noEmit

# Run tests if they exist
if [ -f "jest.config.js" ] || [ -f "jest.config.ts" ]; then
  echo "🧪 Running tests..."
  pnpm test --passWithNoTests
fi

echo "✅ Pre-commit checks passed!"
