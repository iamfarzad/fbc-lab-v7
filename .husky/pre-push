#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Only run on push to main
branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$branch" = "main" ]; then
  echo "🚀 Pushing to main - running pre-deployment checks..."
  ./scripts/pre-deploy-check.sh
else
  echo "✅ Not pushing to main - skipping pre-deployment checks"
fi
