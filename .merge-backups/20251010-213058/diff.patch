+
+// Sound Wave Component with AI States
+const SoundWave = ({ 
+  isRecording, 
+  isProcessing, 
+  volume = 0.5 
+}: { 
+  isRecording: boolean; 
+  isProcessing: boolean; 
+  volume?: number; 
+}) => {
+  const bars = Array.from({ length: 12 }, (_, i) => {
+    const height = isRecording ? Math.random() * 20 + 4 : 4;
+    const delay = i * 0.1;
+    
+    return (
+      <motion.div
+        key={i}
+        className="bg-current w-1 rounded-full"
+        style={{ height: `${height}px` }}
+        animate={isRecording ? {
+          height: [`${height}px`, `${Math.random() * 20 + 4}px`, `${height}px`],
+          opacity: [0.6, 1, 0.6]
+        } : {}}
+        transition={{
+          duration: 0.5,
+          delay,
+          repeat: isRecording ? Infinity : 0,
+          ease: "easeInOut"
+        }}
+      />
+    );
+  });
+
+  return (
+    <div className="flex items-center gap-1 h-6">
+      {bars}
+      {isProcessing && (
+        <motion.div
+          className="ml-2 text-xs text-muted-foreground"
