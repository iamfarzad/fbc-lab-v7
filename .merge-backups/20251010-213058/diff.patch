+          </span>
+        )}
+      </div>
+    </div>
+  );
+};
+
+// Video Preview Component
+const VideoPreview = ({ 
+  stream, 
+  type, 
+  onToggle, 
+  onSwitchCamera,
+  isActive,
+  error 
