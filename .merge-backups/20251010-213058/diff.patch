+import { EnhancedChatMessage } from '@/types/chat-enhanced';
+import { ResearchSummary } from '../../hooks/useChatMessages';
+
+// Mock the AI elements and other dependencies
+jest.mock('@/components/ai-elements/conversation', () => ({
+  Conversation: ({ children }: { children: React.ReactNode }) => <div data-testid="conversation">{children}</div>,
+  ConversationContent: ({ children }: { children: React.ReactNode }) => <div data-testid="conversation-content">{children}</div>,
+  ConversationScrollButton: () => <div data-testid="scroll-button" />,
+}));
+
+jest.mock('@/components/ai-elements/message', () => ({
+  Message: ({ children, from }: { children: React.ReactNode; from: string }) => (
+    <div data-testid={`message-${from}`}>{children}</div>
+  ),
+  MessageContent: ({ children }: { children: React.ReactNode }) => (
+    <div data-testid="message-content">{children}</div>
+  ),
+  MessageAvatar: () => <div data-testid="message-avatar" />,
+}));
+
+jest.mock('@/components/ai-elements/loader', () => ({
+  Loader: () => <div data-testid="loader">Loading...</div>,
+}));
+
+describe('ChatMessages', () => {
+  const mockProps = {
+    messages: [],
+    enhancedMessages: [] as EnhancedChatMessage[],
+    researchSummaries: [] as ResearchSummary[],
+    isLoading: false,
+    contextReady: true,
+    currentContext: {
+      company: { name: 'Test Company' },
+      person: { fullName: 'Test User' }
+    },
+    hasAcceptedTerms: true,
+    onSendMessage: jest.fn(),
+    aiElements: {
+      showReasoning: true,
+      showSources: true,
+      showActions: true,
+      showCodeBlocks: true,
+      showArtifacts: true,
+      showImages: true,
+      showInlineCitations: true,
+      showSuggestions: true,
+      showTasks: true,
+      showWebPreview: true,
+      enableReactions: true,
+      enableReadReceipts: true,
+      enableTypingIndicators: true,
+    },
+    artifacts: [],
+  };
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  describe('Empty State', () => {
+    it('should render welcome message when no messages exist', () => {
+      render(<ChatMessages {...mockProps} />);
+
+      expect(screen.getByText(/Welcome to F\.B\/c AI/)).toBeInTheDocument();
+      expect(screen.getByTestId('conversation')).toBeInTheDocument();
+    });
+
+    it('should show terms acceptance when terms not accepted', () => {
+      render(<ChatMessages {...mockProps} hasAcceptedTerms={false} />);
+
+      expect(screen.getByTestId('terms-acceptance')).toBeInTheDocument();
+    });
+  });
+
+  describe('Message Rendering', () => {
+    const mockMessage: EnhancedChatMessage = {
+      id: '1',
+      content: 'Hello, how can I help you?',
+      role: 'assistant',
+      timestamp: new Date(),
+      type: 'text',
+      status: 'delivered',
+      metadata: {
+        sources: [
+          { id: 'source-1', title: 'Test Source', url: 'https://example.com' }
+        ]
+      }
+    };
+
+    it('should render assistant messages correctly', () => {
+      render(<ChatMessages {...mockProps} enhancedMessages={[mockMessage]} />);
+
+      expect(screen.getByTestId('message-assistant')).toBeInTheDocument();
+      expect(screen.getByText('Hello, how can I help you?')).toBeInTheDocument();
+      expect(screen.getByText('Assistant')).toBeInTheDocument();
