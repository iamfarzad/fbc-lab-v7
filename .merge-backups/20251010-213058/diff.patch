@@ -0,0 +1,236 @@
+#!/usr/bin/env node
+
+/**
+ * Phase 1: Core Functionality Testing
+ * Tests conversation flow detection, phase detection, and question generation
+ */
+
+import { ConversationalIntelligence } from './src/core/intelligence/conversational-intelligence.ts'
+
+// Test data
+const testMessages = [
+  { role: 'user', content: 'Hi, I need help with AI training for my team' },
+  { role: 'assistant', content: 'Great! I can help with that. How many people are we talking about?' },
+  { role: 'user', content: 'About 15 people in our sales department' },
+  { role: 'assistant', content: 'Perfect. What\'s their current experience with AI tools?' },
+  { role: 'user', content: 'Most have never used AI before, they\'re struggling with manual processes' }
+]
+
+const testContext = {
+  lead: { name: 'John Doe', email: 'john@company.com' },
+  company: { name: 'TechCorp', industry: 'Technology', size: '50-200' },
+  person: { role: 'Sales Manager', seniority: 'mid' },
+  pain_points: ['manual processes', 'inefficient workflows'],
+  business_goals: ['improve efficiency', 'reduce manual work'],
+  data_readiness: 'basic',
+  budget_range: '5k-10k',
+  timeline: 'next quarter',
+  decision_authority: 'yes'
+}
+
+async function testConversationFlowDetection() {
+  console.log('🧪 Testing Conversation Flow Detection...')
+  
+  const ci = new ConversationalIntelligence()
+  
+  // Test workshop flow detection
+  const workshopMessages = [
+    { role: 'user', content: 'We need to train our team on AI tools' },
+    { role: 'user', content: 'Our employees don\'t know how to use ChatGPT effectively' }
+  ]
+  
+  const workshopFlow = ci.detectServiceIntent(workshopMessages, testContext)
+  console.log(`✅ Workshop flow detected: ${workshopFlow}`)
+  
+  // Test consulting flow detection
+  const consultingMessages = [
+    { role: 'user', content: 'We need to build a custom AI system' },
+    { role: 'user', content: 'Our current workflow is inefficient and needs automation' }
+  ]
+  
+  const consultingFlow = ci.detectServiceIntent(consultingMessages, testContext)
+  console.log(`✅ Consulting flow detected: ${consultingFlow}`)
+  
+  // Test unclear flow
+  const unclearMessages = [
+    { role: 'user', content: 'We want to explore AI options' }
+  ]
+  
+  const unclearFlow = ci.detectServiceIntent(unclearMessages, testContext)
+  console.log(`✅ Unclear flow detected: ${unclearFlow}`)
+}
+
+async function testPhaseDetection() {
+  console.log('\n🧪 Testing Phase Detection...')
+  
+  const ci = new ConversationalIntelligence()
+  
+  // Test phase progression
+  const phases = [
+    { messages: [], context: {}, expected: 'discovery' },
+    { messages: testMessages.slice(0, 2), context: { ...testContext, pain_points: [] }, expected: 'discovery' },
+    { messages: testMessages.slice(0, 3), context: { ...testContext, pain_points: ['manual processes'] }, expected: 'technical_feasibility' },
+    { messages: testMessages.slice(0, 4), context: { ...testContext, data_readiness: 'basic' }, expected: 'scoping' },
+    { messages: testMessages, context: { ...testContext, budget_range: '5k-10k', timeline: 'next quarter' }, expected: 'recommendation' }
+  ]
+  
+  for (const phase of phases) {
+    const detectedPhase = ci.detectConversationPhase(phase.messages, phase.context)
+    const status = detectedPhase === phase.expected ? '✅' : '❌'
+    console.log(`${status} Phase: ${detectedPhase} (expected: ${phase.expected})`)
+  }
+}
+
+async function testQuestionGeneration() {
+  console.log('\n🧪 Testing Question Generation...')
+  
+  const ci = new ConversationalIntelligence()
+  
+  // Test contextual questions
+  const testCases = [
+    {
+      message: 'Our team struggles with manual data entry',
+      context: { ...testContext, pain_points: [] },
+      expected: 'pain point follow-up'
+    },
+    {
+      message: 'We have about 20 people on the team',
+      context: { ...testContext, data_readiness: null },
+      expected: 'team size question'
+    },
+    {
+      message: 'We want to improve efficiency',
+      context: { ...testContext, company: { industry: 'Manufacturing' } },
+      expected: 'industry-specific question'
+    }
+  ]
+  
+  for (const testCase of testCases) {
+    const question = ci.generateNextQuestion(
+      testCase.message,
+      testCase.context,
+      testMessages.map(m => m.content),
+      testMessages.length
+    )
+    
+    if (question) {
+      console.log(`✅ Generated question: "${question.question}"`)
+      console.log(`   Rationale: ${question.rationale}`)
+    } else {
+      console.log(`❌ No question generated for: "${testCase.message}"`)
+    }
+  }
+}
+
+async function testMultimodalSuggestions() {
+  console.log('\n🧪 Testing Multimodal Suggestions...')
+  
+  const ci = new ConversationalIntelligence()
+  
+  // Test demo suggestions
+  const testCases = [
+    {
+      message: 'Our current system is really complex and hard to explain',
+      messageCount: 4,
+      flow: 'consulting',
+      expected: 'screen share suggestion'
+    },
+    {
+      message: 'We have a physical warehouse with picking processes',
+      messageCount: 3,
+      flow: 'workshop',
+      expected: 'webcam suggestion'
+    },
+    {
+      message: 'We get tons of customer support tickets but don\'t know patterns',
+      messageCount: 2,
+      flow: 'consulting',
+      expected: 'document upload suggestion'
+    }
+  ]
+  
+  for (const testCase of testCases) {
+    const suggestions = ci.suggestMultimodalDemonstration(
+      testCase.message,
+      testCase.messageCount,
+      testCase.flow
+    )
+    
+    if (suggestions && suggestions.length > 0) {
+      console.log(`✅ Generated ${suggestions.length} suggestions for: "${testCase.message}"`)
+      suggestions.forEach(s => console.log(`   - ${s.type}: "${s.message}"`))
+    } else {
+      console.log(`❌ No suggestions generated for: "${testCase.message}"`)
+    }
+  }
+}
+
+async function testDemoEngagement() {
+  console.log('\n🧪 Testing Demo Engagement Tracking...')
+  
+  const ci = new ConversationalIntelligence()
+  
+  // Test wow moment detection
+  const testCases = [
+    { message: 'Wow, that\'s exactly what we need!', expected: 'high' },
+    { message: 'This is impressive, I didn\'t know AI could do this', expected: 'high' },
+    { message: 'Interesting, that makes sense', expected: 'medium' },
+    { message: 'Okay, I understand', expected: 'low' }
+  ]
+  
+  for (const testCase of testCases) {
+    const engagement = ci.trackDemoEngagement(testCase.message, 'voice')
+    const status = engagement.engagementLevel === testCase.expected ? '✅' : '❌'
+    console.log(`${status} Engagement: ${engagement.engagementLevel} (expected: ${testCase.expected})`)
+    console.log(`   Wow detected: ${engagement.wowDetected}`)
+  }
+}
+
+async function testLeadQualification() {
+  console.log('\n🧪 Testing Lead Qualification...')
+  
+  const ci = new ConversationalIntelligence()
+  
+  // Test qualification criteria
+  const testCases = [
+    {
+      context: { ...testContext, pain_points: ['manual', 'inefficient'], budget_range: '5k', timeline: 'next month', decision_authority: 'yes' },
+      conversationHistory: [{ role: 'user', content: 'We\'re interested in consulting' }],
+      expected: true
+    },
+    {
+      context: { ...testContext, pain_points: ['manual'], budget_range: null },
+      conversationHistory: [{ role: 'user', content: 'Just exploring options' }],
+      expected: false
+    }
+  ]
+  
+  for (const testCase of testCases) {
+    const isQualified = ci.checkLeadQualification(testCase.context, testCase.conversationHistory)
+    const status = isQualified === testCase.expected ? '✅' : '❌'
+    console.log(`${status} Lead qualified: ${isQualified} (expected: ${testCase.expected})`)
+  }
+}
+
+async function runPhase1Tests() {
+  console.log('🚀 Starting Phase 1: Core Functionality Testing\n')
+  
+  try {
+    await testConversationFlowDetection()
+    await testPhaseDetection()
+    await testQuestionGeneration()
+    await testMultimodalSuggestions()
+    await testDemoEngagement()
+    await testLeadQualification()
+    
+    console.log('\n✅ Phase 1 Testing Complete!')
+    console.log('All core functionality tests passed.')
+    
+  } catch (error) {
+    console.error('❌ Phase 1 Testing Failed:', error)
+    process.exit(1)
+  }
+}
+
+// Run tests
+runPhase1Tests()
