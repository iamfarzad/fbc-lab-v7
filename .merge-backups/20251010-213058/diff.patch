+        </div>
+      </div>
+      
+      <div className="relative bg-black rounded-lg overflow-hidden aspect-video">
+        {stream && isActive ? (
+          <video
+            ref={videoRef}
+            className="w-full h-full object-cover"
+            autoPlay
+            muted
