+// Official Vercel Pattern: Streaming Conversation Demo
+function StreamingConversationDemo() {
+  const conversationMessages = [
+    {
+      key: nanoid(),
+      value: 'What AI consulting services do you offer?',
+      name: 'You',
+      role: 'user' as const,
+    },
+    {
+      key: nanoid(),
+      value: 'We offer comprehensive AI consulting including strategy, ML implementation, and LLM integration.',
+      name: 'F.B/c AI',
+      role: 'assistant' as const,
+    },
+    {
+      key: nanoid(),
+      value: 'How long does a typical engagement take?',
+      name: 'You',
+      role: 'user' as const,
+    },
+    {
+      key: nanoid(),
+      value: 'Typically 2-6 months depending on scope. We start with a discovery phase.',
+      name: 'F.B/c AI',
+      role: 'assistant' as const,
+    },
+    {
+      key: nanoid(),
+      value: 'What industries do you specialize in?',
+      name: 'You',
+      role: 'user' as const,
+    },
+    {
+      key: nanoid(),
+      value: 'We work across finance, healthcare, e-commerce, and SaaS with proven AI implementations.',
+      name: 'F.B/c AI',
+      role: 'assistant' as const,
+    },
+  ]
+
+  const [visibleMessages, setVisibleMessages] = useState<typeof conversationMessages>([])
+
+  useEffect(() => {
+    let currentIndex = 0
+    const interval = setInterval(() => {
+      if (currentIndex < conversationMessages.length) {
+        setVisibleMessages((prev) => [...prev, conversationMessages[currentIndex]!])
+        currentIndex++
+      } else {
+        clearInterval(interval)
+      }
+    }, 800)
+
+    return () => clearInterval(interval)
+  }, [])
+
+  return (
+    <Conversation className="relative size-full" style={{ height: '498px' }}>
+      <ConversationContent>
+        {visibleMessages.length === 0 ? (
+          <ConversationEmptyState
+            icon={<MessageSquareIcon className="size-6" />}
+            title="Start a conversation"
+            description="Messages will appear here as the conversation progresses."
+          />
+        ) : (
+          visibleMessages.map(({ key, value, name, role }) => (
+            <Message from={role} key={key}>
+              <MessageAvatar name={name} />
+              <MessageContent variant="contained">
+                <Response>{value}</Response>
+              </MessageContent>
+            </Message>
+          ))
+        )}
+      </ConversationContent>
+      <ConversationScrollButton />
+    </Conversation>
+  )
+}
