+import React, { useState, useRef, useEffect } from 'react';
+import { motion, AnimatePresence } from 'framer-motion';
+import { 
+  Camera, 
+  CameraOff, 
+  Monitor, 
+  MonitorOff, 
+  Mic, 
+  MicOff, 
+  Video, 
+  VideoOff,
+  ChevronUp,
+  ChevronDown,
+  X
+} from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { cn } from '@/lib/utils';
+import { toast } from 'sonner';
+
+interface FloatingMediaControlsProps {
+  // Voice state
+  isVoiceActive: boolean;
+  isVoiceProcessing: boolean;
+  isVoiceSupported: boolean;
+  isMuted: boolean;
+  voiceError?: string;
+  onToggleVoice: () => void;
+  
+  // Camera state
+  isCameraActive: boolean;
+  cameraError?: string;
+  onToggleCamera: () => void;
+  
+  // Screen share state
+  isScreenSharing: boolean;
+  screenShareError?: string;
+  onToggleScreenShare: () => void;
+  
+  // Media streams
+  cameraStream: MediaStream | null;
+  screenShareStream: MediaStream | null;
+  
+  // UI state
+  isExpanded: boolean;
+  className?: string;
+}
+
+export function FloatingMediaControls({
+  isVoiceActive,
+  isVoiceProcessing,
+  isVoiceSupported,
+  isMuted,
+  voiceError,
+  onToggleVoice,
+  isCameraActive,
+  cameraError,
+  onToggleCamera,
+  isScreenSharing,
+  screenShareError,
+  onToggleScreenShare,
+  cameraStream,
+  screenShareStream,
+  isExpanded,
+  className
+}: FloatingMediaControlsProps) {
+  const [isOpen, setIsOpen] = useState(false);
+  const [activePreview, setActivePreview] = useState<'camera' | 'screen' | null>(null);
+  const videoRef = useRef<HTMLVideoElement>(null);
+  const containerRef = useRef<HTMLDivElement>(null);
+
+  // Update video stream when active preview changes
+  useEffect(() => {
+    const video = videoRef.current;
+    if (!video) return;
+
+    const stream = activePreview === 'camera' ? cameraStream : 
+                   activePreview === 'screen' ? screenShareStream : null;
+
+    if (stream) {
+      video.srcObject = stream;
+      video.play().catch(console.error);
+    } else {
+      video.srcObject = null;
+    }
+  }, [activePreview, cameraStream, screenShareStream]);
+
+  // Auto-open when media becomes active
+  useEffect(() => {
+    if (isCameraActive || isScreenSharing || isVoiceActive) {
+      setIsOpen(true);
+    }
+  }, [isCameraActive, isScreenSharing, isVoiceActive]);
+
+  const hasActiveMedia = isCameraActive || isScreenSharing || isVoiceActive;
+  const hasErrors = Boolean(voiceError || cameraError || screenShareError);
+
+  const handleTogglePreview = (type: 'camera' | 'screen') => {
+    if (activePreview === type) {
+      setActivePreview(null);
+    } else {
+      setActivePreview(type);
+    }
+  };
+
+  const handleClosePreview = () => {
+    setActivePreview(null);
+  };
+
+  // Always render the floating controls, but show different states
+
+  return (
+    <div 
+      ref={containerRef}
+      className={cn(
+        "transition-all duration-300",
+        className
+      )}
+      style={{
+        position: 'absolute',
+        zIndex: 10,
+        ...(isExpanded ? {
+          top: '16px',
+          right: '16px'
+        } : {
+          top: '16px',
+          right: '16px'
+        })
+      }}
+    >
+      <AnimatePresence>
+        {isOpen && (
+          <motion.div
+            initial={{ opacity: 0, y: 20, scale: 0.9 }}
+            animate={{ opacity: 1, y: 0, scale: 1 }}
+            exit={{ opacity: 0, y: 20, scale: 0.9 }}
+            transition={{ duration: 0.2 }}
+            className={cn(
+              "bg-background/95 backdrop-blur-sm border border-border/40 shadow-lg p-2 space-y-2 min-w-[200px]",
+              "rounded-xl",
+              "[.monochrome_&]:rounded-none [.monochrome_&]:shadow-none [.monochrome_&]:border-2"
+            )}
+          >
+            {/* Compact Header */}
+            <div className="flex items-center justify-between">
+              <div className="flex items-center gap-1">
+                <div className="h-1.5 w-1.5 rounded-full bg-green-500 animate-pulse" />
+                <span className="text-[10px] font-medium text-muted-foreground uppercase tracking-wide [.monochrome_&]:font-mono">
+                  <span className="hidden [.monochrome_&]:inline">$ </span>
+                  Media
+                </span>
+              </div>
+              <Button
+                variant="ghost"
+                size="sm"
+                onClick={() => setIsOpen(false)}
+                className="h-5 w-5 p-0 hover:bg-muted/50"
+              >
+                <ChevronDown className="h-2.5 w-2.5" />
+              </Button>
+            </div>
+
+            {/* Compact Voice Controls */}
+            <div className="flex items-center justify-between">
+              <div className="flex items-center gap-2">
+                <div className={cn(
+                  "h-6 w-6 rounded-full flex items-center justify-center transition-colors",
+                  isVoiceActive && !isMuted 
+                    ? "bg-green-500 text-white" 
+                    : isVoiceActive && isMuted
+                    ? "bg-yellow-500 text-white"
+                    : "bg-muted text-muted-foreground"
+                )}>
+                  {isVoiceProcessing ? (
+                    <div className="h-2 w-2 rounded-full bg-current animate-pulse" />
+                  ) : isVoiceActive ? (
+                    isMuted ? <MicOff className="h-3 w-3" /> : <Mic className="h-3 w-3" />
+                  ) : (
+                    <Mic className="h-3 w-3" />
+                  )}
+                </div>
+                <div>
+                  <p className="text-[10px] font-medium">
+                    {isVoiceActive ? (isMuted ? 'Muted' : 'Active') : 'Voice'}
+                  </p>
+                  {voiceError && (
+                    <p className="text-[9px] text-red-500">{voiceError}</p>
+                  )}
+                </div>
+              </div>
+              <Button
+                variant="ghost"
+                size="sm"
+                onClick={onToggleVoice}
+                disabled={!isVoiceSupported}
+                className="h-6 px-2 text-[10px]"
+              >
+                {isVoiceActive ? (isMuted ? 'Unmute' : 'Mute') : 'Start'}
+              </Button>
+            </div>
+
+            {/* Compact Camera Controls */}
+            <div className="flex items-center justify-between">
+              <div className="flex items-center gap-2">
+                <div className={cn(
+                  "h-6 w-6 rounded-full flex items-center justify-center transition-colors",
+                  isCameraActive 
+                    ? "bg-blue-500 text-white" 
+                    : "bg-muted text-muted-foreground"
+                )}>
+                  {isCameraActive ? (
+                    <Camera className="h-3 w-3" />
+                  ) : (
+                    <CameraOff className="h-3 w-3" />
+                  )}
+                </div>
+                <div>
+                  <p className="text-[10px] font-medium">
+                    {isCameraActive ? 'Active' : 'Camera'}
+                  </p>
+                  {cameraError && (
+                    <p className="text-[9px] text-red-500">{cameraError}</p>
+                  )}
+                </div>
+              </div>
+              <div className="flex items-center gap-1">
+                {isCameraActive && (
+                  <Button
+                    variant="ghost"
+                    size="sm"
+                    onClick={() => handleTogglePreview('camera')}
+                    className="h-6 px-1 text-[10px]"
+                  >
+                    <Video className="h-2.5 w-2.5" />
+                  </Button>
+                )}
+                <Button
+                  variant="ghost"
+                  size="sm"
+                  onClick={onToggleCamera}
+                  className="h-6 px-2 text-[10px]"
+                >
+                  {isCameraActive ? 'Stop' : 'Start'}
+                </Button>
+              </div>
+            </div>
+
+            {/* Compact Screen Share Controls */}
+            <div className="flex items-center justify-between">
+              <div className="flex items-center gap-2">
+                <div className={cn(
+                  "h-6 w-6 rounded-full flex items-center justify-center transition-colors",
+                  isScreenSharing 
+                    ? "bg-purple-500 text-white" 
+                    : "bg-muted text-muted-foreground"
