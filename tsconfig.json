{
  "compilerOptions": {
    "target": "ES2018",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2018"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    // STRICT MODE ENABLED - No more permissive TypeScript
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    // Additional strictness
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // Keep Next.js compatibility
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/src/*": [
        "./src/*"
      ],
      "@/app/*": [
        "./app/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "app/chat-ui-test/**",
    "scripts/log-collectors/**",
    "scripts/test-logging.ts",
    "scripts/test-enhancements.ts",
    // Exclude legacy test files that are not currently used
    "src/hooks/useRoom.ts",
    "src/hooks/useChatMessages.ts", 
    "src/hooks/useDebug.ts",
    "src/components/agent-ui/AgentInterface.tsx",
    "src/components/livekit/LiveKitRoom.tsx",
    "app/livekit-demo/**"
  ]
}
